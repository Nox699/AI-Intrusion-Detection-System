// Systemoversigt. Kilder og forklaring: ../ARCHITECTURE.md
// Render med Graphviz: dot -Tsvg architecture.dot -o architecture.svg
digraph Yggdrasil {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.42,
         ranksep=0.68, splines=polyline, fontname="Arial", fontsize=14,
         compound=true];
  node [shape=box, style="filled", fillcolor="#f5f7fa", color="#526171",
        penwidth=1.1, fontname="Arial", fontsize=12, fontcolor="#18232f",
        margin="0.16,0.12"];
  edge [color="#526171", penwidth=1.0, arrowsize=0.7,
        fontname="Arial", fontsize=10, fontcolor="#334155"];

  subgraph cluster_pi {
    label="Yggdrasil IDS  |  Raspberry Pi 5 · Debian 13";
    labelloc=t; labeljust=l; color="#94a3b8"; penwidth=1.1; margin=20;

    journal [label="systemd-journald\nSSH · UFW · sudo", shape=note];
    model [label="SSH-model (JSON)\nFast træningsgrundlag", shape=note];

    collector [label="SSH/UFW-collector\nSSH: regler + Isolation Forest\nPreauth og TCP: regler",
               fillcolor="#e8eef5"];
    sudo [label="Sudo-job\nIndsamling og regler\nTimer · ca. hvert minut",
          fillcolor="#e8eef5"];

    database [label="Produktionsdatabase\nSQLite\nHistorik, alarmer og outbox", shape=cylinder];
    private_sudo [label="Privat sudo-database\nSQLite · normaliserede signaler", shape=cylinder];
    exports [label="Anonyme sudo-data\nJSON · status og aktivitet", shape=note];

    web [label="Dashboard\nFlask / Gunicorn\nLogin og kun læseadgang", fillcolor="#e8eef5"];
    notifier [label="Discord-notifier\nBehandler nye outbox-job", fillcolor="#e8eef5"];
    receipts [label="Privat leveringsdatabase\nSQLite · kvitteringer", shape=cylinder];

    { rank=same; journal; model; }
    { rank=same; collector; sudo; }
    { rank=same; database; private_sudo; exports; }
    { rank=same; web; notifier; }

    journal -> collector [label="SSH / UFW"];
    journal -> sudo [label="sudo"];
    model -> collector [label="indlæses"];
    collector -> database [label="gemmer analyser"];
    sudo -> private_sudo [dir=both, label="læser / skriver"];
    sudo -> database [label="sudo-alarmer"];
    sudo -> exports [label="udgiver"];
    database -> web [label="historik / alarmer"];
    exports -> web [label="sudo-visning"];
    database -> notifier [label="outbox"];
    notifier -> receipts [dir=both, label="leveringsstatus"];
  }

  browser [label="Browser på laptop\nDashboard via SSH-tunnel", fillcolor="white"];
  discord [label="Discord\nAlarmbeskeder", fillcolor="white"];
  { rank=same; browser; discord; }
  // Placer de eksterne modtagere under Pi-grænsen.
  receipts -> discord [style=invis];
  receipts -> browser [style=invis];
  web -> browser [label="127.0.0.1:8765\nvia SSH-tunnel"];
  notifier -> discord [label="HTTPS / webhook"];
}
