[Unit]
Description=Yggdrasil IDS private dashboard
After=network.target yggdrasil-collector.service
Wants=yggdrasil-collector.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Environment=PYTHONPATH=/opt/yggdrasil-ids/current/src
Environment=PYTHONDONTWRITEBYTECODE=1
Type=simple
User=yggdrasil-web
Group=yggdrasil-web
SupplementaryGroups=yggdrasil-data
WorkingDirectory=/opt/yggdrasil-ids
ExecStart=/opt/yggdrasil-ids/venv/bin/python -m yggdrasil_ids serve --config /etc/yggdrasil-ids/config.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/var/lib/yggdrasil-ids /var/lib/yggdrasil-sudo-public
MemoryMax=768M
TasksMax=64

[Install]
WantedBy=multi-user.target
